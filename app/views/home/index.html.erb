<div class="container mt-5">
  <h1>Sistema de Biblioteca Digital</h1>
  <p class="lead">
    Gerencie o acervo de livros, autores e empréstimos da biblioteca.
  </p>

  <div class="d-flex gap-2 mt-4">
    <%= link_to "Ver Livros", livros_path, class: "btn btn-primary" %>
    <%= link_to "Ver Autores", autors_path, class: "btn btn-secondary" %>
    <%= link_to "Ver Empréstimos", emprestimos_path, class: "btn btn-success" %>
  </div>
</div>