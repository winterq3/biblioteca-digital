<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
  <div class="col">
    <div class="card text-center p-3">
      <h2><%= @total_livros %></h2>
      <p class="mb-0 text-muted">Livros no total</p>
    </div>
  </div>
  <div class="col">
    <div class="card text-center p-3">
      <h2><%= @livros_disponiveis %></h2>
      <p class="mb-0 text-muted">Disponíveis</p>
    </div>
  </div>
  <div class="col">
    <div class="card text-center p-3">
      <h2><%= @total_autores %></h2>
      <p class="mb-0 text-muted">Autores</p>
    </div>
  </div>
  <div class="col">
    <div class="card text-center p-3">
      <h2><%= @emprestimos_abertos %></h2>
      <p class="mb-0 text-muted">Empréstimos em aberto</p>
    </div>
  </div>
</div>

<div class="container mt-5">
  <h1>Sistema de Biblioteca Digital</h1>
  <p class="lead">
    Gerencie o acervo de livros, autores e empréstimos da biblioteca.
  </p>

  <div class="d-flex gap-2 mt-4">
    <%= link_to "Ver Livros", livros_path, class: "btn btn-primary" %>
    <%= link_to "Ver Autores", autors_path, class: "btn btn-secondary" %>
    <%= link_to "Ver Empréstimos", emprestimos_path, class: "btn btn-success" %>
  </div>
</div>