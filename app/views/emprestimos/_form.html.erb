<%= form_with(model: emprestimo) do |form| %>
  <% if emprestimo.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(emprestimo.errors.count, "erro") %> impediram este empréstimo de ser salvo:</h2>
      <ul class="mb-0">
        <% emprestimo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :livro_id, "Livro", class: "form-label" %>
    <%= form.collection_select :livro_id, Livro.all, :id, :titulo, { prompt: "Selecione um livro" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :nome_leitor, "Nome do leitor", class: "form-label" %>
    <%= form.text_field :nome_leitor, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :data_emprestimo, "Data do empréstimo", class: "form-label" %>
    <%= form.date_field :data_emprestimo, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :data_devolucao, "Data de devolução", class: "form-label" %>
    <%= form.date_field :data_devolucao, class: "form-control" %>
  </div>

  <div class="form-check mb-3">
    <%= form.checkbox :devolvido, class: "form-check-input" %>
    <%= form.label :devolvido, "Devolvido", class: "form-check-label" %>
  </div>

  <%= form.submit emprestimo.new_record? ? "Criar Empréstimo" : "Atualizar Empréstimo", class: "btn btn-primary" %>
<% end %>