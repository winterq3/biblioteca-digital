<div class="card">
  <div class="card-body">
    <%= render @emprestimo %>
  </div>
  <div class="card-footer d-flex gap-2">
    <%= link_to "Editar", edit_emprestimo_path(@emprestimo), class: "btn btn-secondary" %>
    <%= link_to "← Voltar", emprestimos_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Excluir", @emprestimo, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-danger ms-auto" %>
  </div>
</div>