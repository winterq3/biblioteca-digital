<% content_for :title, "Empréstimos" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Empréstimos</h1>
  <%= link_to "+ Novo Empréstimo", new_emprestimo_path, class: "btn btn-primary" %>
</div>

<div id="emprestimos" class="row row-cols-1 row-cols-md-3 g-4">
  <% @emprestimos.each do |emprestimo| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <%= render emprestimo %>
        </div>
        <div class="card-footer d-flex gap-2">
          <%= link_to "Editar", edit_emprestimo_path(emprestimo), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Excluir", emprestimo, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>