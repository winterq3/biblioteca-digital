<% content_for :title, "Livros" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Livros</h1>
    <% if params[:autor_id].present? %>
      <div class="alert alert-info">
        Mostrando livros de <strong><%= Autor.find(params[:autor_id]).nome %></strong>.
    <%= link_to "Ver todos os livros", livros_path %>
      </div>
    <% end %>
  <%= link_to "+ Novo Livro", new_livro_path, class: "btn btn-primary" %>
</div>

<div id="livros" class="row row-cols-1 row-cols-md-3 g-4">
  <% @livros.each do |livro| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <%= render livro %>
        </div>
        <div class="card-footer d-flex gap-2">
          <%= link_to "Editar", edit_livro_path(livro), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Excluir", livro, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>