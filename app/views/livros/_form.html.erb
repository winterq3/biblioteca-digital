<%= form_with(model: livro) do |form| %>
  <% if livro.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(livro.errors.count, "erro") %> impediram este livro de ser salvo:</h2>
      <ul class="mb-0">
        <% livro.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :titulo, class: "form-label" %>
    <%= form.text_field :titulo, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :ano_publicacao, "Ano de publicação", class: "form-label" %>
    <%= form.number_field :ano_publicacao, class: "form-control" %>
  </div>

  <div class="form-check mb-3">
    <%= form.checkbox :disponivel, class: "form-check-input" %>
    <%= form.label :disponivel, "Disponível", class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= form.label :autor_id, "Autor", class: "form-label" %>
    <%= form.collection_select :autor_id, Autor.all, :id, :nome, { prompt: "Selecione um autor" }, { class: "form-select" } %>
  </div>

  <%= form.submit livro.new_record? ? "Criar Livro" : "Atualizar Livro", class: "btn btn-primary" %>
<% end %>