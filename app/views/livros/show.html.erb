<div class="card">
  <div class="card-body">
    <%= render @livro %>
  </div>
  <div class="card-footer d-flex gap-2">
    <%= link_to "Editar", edit_livro_path(@livro), class: "btn btn-secondary" %>
    <%= link_to "← Voltar", livros_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Excluir", @livro, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-danger ms-auto" %>
  </div>
</div>