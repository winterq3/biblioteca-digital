<div id="<%= dom_id livro %>">
  <h5 class="card-title"><%= livro.titulo %></h5>
  <p class="text-muted mb-1">por <%= livro.autor.nome %></p>
  <p class="mb-1"><strong>Ano:</strong> <%= livro.ano_publicacao %></p>
  <p class="mb-0">
    <% if livro.disponivel %>
      <span class="badge bg-success">Disponível</span>
    <% else %>
      <span class="badge bg-secondary">Indisponível</span>
    <% end %>
  </p>
</div>