<div id="<%= dom_id livro %>">
  <div>
    <strong>Titulo:</strong>
    <%= livro.titulo %>
  </div>

  <div>
    <strong>Ano publicacao:</strong>
    <%= livro.ano_publicacao %>
  </div>

  <div>
    <strong>Disponivel:</strong>
    <%= livro.disponivel %>
  </div>

  <div>
    <strong>Autor:</strong>
    <%= livro.autor_id %>
  </div>

</div>
