<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Biblioteca Digital" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Biblioteca Digital">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "📚 Biblioteca Digital", root_path, class: "navbar-brand" %>
        <div class="navbar-nav">
          <%= link_to "Livros", livros_path, class: "nav-link text-white" %>
          <%= link_to "Autores", autors_path, class: "nav-link text-white" %>
          <%= link_to "Empréstimos", emprestimos_path, class: "nav-link text-white" %>
          <% if user_signed_in? %>
            <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "nav-link text-white" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "nav-link text-white" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>
      
      <%= yield %>
    </div>  
  </body>
</html>
