<% content_for :title, "Autores" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Autores</h1>
  <%= link_to "+ Novo Autor", new_autor_path, class: "btn btn-primary" %>
</div>

<div id="autors" class="row row-cols-1 row-cols-md-3 g-4">
  <% @autors.each do |autor| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <%= render autor %>
        </div>
        <div class="card-footer d-flex gap-2">
          <%= link_to "Editar", edit_autor_path(autor), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Excluir", autor, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>