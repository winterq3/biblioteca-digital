<div class="card">
  <div class="card-body">
    <%= render @autor %>
  </div>
  <div class="card-footer d-flex gap-2">
    <%= link_to "Editar", edit_autor_path(@autor), class: "btn btn-secondary" %>
    <%= link_to "← Voltar", autors_path, class: "btn btn-outline-secondary" %>
    <%= button_to "Excluir", @autor, method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-danger ms-auto" %>
  </div>
</div>