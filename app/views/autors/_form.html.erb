<%= form_with(model: autor) do |form| %>
  <% if autor.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(autor.errors.count, "erro") %> impediram este autor de ser salvo:</h2>
      <ul class="mb-0">
        <% autor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label" %>
    <%= form.text_field :nome, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :nacionalidade, class: "form-label" %>
    <%= form.text_field :nacionalidade, class: "form-control" %>
  </div>

  <%= form.submit autor.new_record? ? "Criar Autor" : "Atualizar Autor", class: "btn btn-primary" %>
<% end %>